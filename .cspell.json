{
  "version": "0.2",
  "language": "en-US",
  "allowCompoundWords": false,
  "globRoot": ".",
  "ignorePaths": [
    "node_modules/**",
    "vendor/**",
    "*.min.js",
    "*.min.css",
    "composer.lock",
    "package-lock.json",
    "yarn.lock",
    "**/.*.json",
    ".*ignore",
    ".yarn/**",
    ".git/**"
  ],
  "ignoreRegExpList": [
    "^msgstr .*",
    "!!binary .*",
    "%[0-9][0-9A-F]",
    "\\Wi18n",
    "\\x{[0-9A-F]{4,5}}"
  ],
  "words": [
    "Andriy",
    "Khomych",
    "Getulio",
    "Sánchez",
    "gvso",
    "Utkarsh",
    "denutkarsh",
    "smolblog",
    "Smolblog",
    "dealerdirect",
    "phpcodesniffer",
    "Preg",
    "Openercase",
    "inheritdoc",
    "Squiz",
    "PKCE",
    "Pkce",
    "Drupal",
    "drupal",
    "phpcs",
    "phpcbf",
    "langcode",
    "metatag",
    "isset",
    "sprintf",
    "Symfony",
    "KEYTYPE",
    "LANGCODE",
    "OAuth",
    "twitter",
    "social",
    "auth",
    "cspell",
    "eslint",
    "stylelint",
    "phpunit",
    "coder"
  ]
}
